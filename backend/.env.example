NODE_ENV=development
PORT=5000

# Database
# Local development:
MONGODB_URI=mongodb://localhost:27017/chapel-system
# Production MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/chapel_db?retryWrites=true&w=majority
MONGODB_TLS=false
MONGODB_TLS_ALLOW_INVALID_CERTS=false

# Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=1d
REQUIRE_EMAIL_VERIFICATION=false

# Public URLs / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
BASE_URL=http://localhost:5000

# Email via Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Chapel

# Pesapal API 3.0
# Use sandbox credentials with PESAPAL_ENVIRONMENT=sandbox.
# Use live credentials with PESAPAL_ENVIRONMENT=production.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_API_BASE_URL=
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=http://localhost:5000/api/donations/callback
PESAPAL_CANCELLATION_URL=http://localhost:5173/donations
PESAPAL_BRANCH=
PESAPAL_IPN_NOTIFICATION_TYPE=GET

# Relworx direct mobile money prompts
DONATION_PAYMENT_PROVIDER=pesapal
RELWORX_API_BASE_URL=https://payments.relworx.com/api
RELWORX_API_KEY=
RELWORX_ACCOUNT_NO=
RELWORX_WEBHOOK_KEY=

# Optional legacy/direct mobile money providers
PAYMENT_CALLBACK_SECRET=
MTN_API_URL=
MTN_API_KEY=
AIRTEL_API_URL=
AIRTEL_API_KEY=

# Uploads / media
UPLOAD_MAX_FILE_SIZE_MB=100
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chapel-system

# Deployment
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb

# One-time admin bootstrap
ADMIN_EMAIL=managementchapel98@gmail.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=0000000000
